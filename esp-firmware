#include <esp_now.h>
#include <WiFi.h>
#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <OneWire.h>
#include <DallasTemperature.h>

// PIN DEFINITIONS
#define TRIG_PIN        5
#define ECHO_PIN       18
#define DS18B20_PIN     4
#define RAIN_ANALOG_PIN 34
#define BUZZER_PIN     19

// HARDWARE INITIALIZATION
OneWire oneWire(DS18B20_PIN);
DallasTemperature ds18b20(&oneWire);
Adafruit_MPU6050 mpu;

// GATEWAY TARGET MAC ADDRESS
uint8_t gatewayMac[] = {0x8C, 0x94, 0xDF, 0x68, 0xF6, 0xB8};

// MATCHES GATEWAY STRUCT EXACTLY
typedef struct __attribute__((packed)) {
  char nodeId[16];    // Synchronized field name with Gateway receiver
  float distance;     // Matches receiver 'distance'
  float temperature;  // Matches receiver 'temperature'
  int rain;           // Matches receiver 'rain'
  float vibration;    // Matches receiver 'vibration'
} HazardTelemetry;

HazardTelemetry payload;
esp_now_peer_info_t peerInfo;

void setup() {
  Serial.begin(115200);

  // Pin modes
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  // Sensor Initialization
  ds18b20.begin();
  Wire.begin(21, 22);
  
  if (!mpu.begin()) {
    Serial.println("[Node] Warning: MPU6050 not detected. Check I2C wiring.");
  } else {
    Serial.println("[Node] MPU6050 Initialized.");
  }

  // ESP-NOW Setup
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  if (esp_now_init() != ESP_OK) {
    Serial.println("[Node] ESP-NOW Init Failed!");
    return;
  }

  // Configure Peer (Gateway)
  memset(&peerInfo, 0, sizeof(peerInfo));
  memcpy(peerInfo.peer_addr, gatewayMac, 6);
  peerInfo.channel = 1; // Explicit channel 1 matching gateway
  peerInfo.encrypt = false;
  
  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("[Node] Failed to register Gateway peer.");
  } else {
    Serial.println("[Node] Gateway registered successfully.");
  }

  // Set Node Identifier
  strcpy(payload.nodeId, "ESP_NODE_1");
}

void loop() {
  // 1. Read Ultrasonic Distance
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  
  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  payload.distance = (duration > 0) ? (duration * 0.0343 / 2.0) : 999.0;

  // 2. Read DS18B20 Temp
  ds18b20.requestTemperatures();
  float tempVal = ds18b20.getTempCByIndex(0);
  payload.temperature = (tempVal == DEVICE_DISCONNECTED_C) ? 0.0 : tempVal;

  // 3. Read Rain Sensor
  payload.rain = analogRead(RAIN_ANALOG_PIN);

  // 4. Read MPU6050 Vibration
  sensors_event_t a, g, temp;
  if (mpu.getEvent(&a, &g, &temp)) {
    payload.vibration = sqrt(a.acceleration.x * a.acceleration.x + 
                             a.acceleration.y * a.acceleration.y + 
                             a.acceleration.z * a.acceleration.z) / 9.81;
  } else {
    payload.vibration = 1.0;
  }

  // Local Alarm Trigger
  if (payload.distance < 20.0 || payload.vibration > 2.0) {
    digitalWrite(BUZZER_PIN, HIGH);
  } else {
    digitalWrite(BUZZER_PIN, LOW);
  }

  // Transmit Data Packet over ESP-NOW
  esp_err_t result = esp_now_send(gatewayMac, (uint8_t *)&payload, sizeof(payload));
  if (result == ESP_OK) {
    Serial.println("[Node] Telemetry packet sent successfully.");
  } else {
    Serial.print("[Node] Transmission error code: ");
    Serial.println(result);
  }

  delay(2000);
}
