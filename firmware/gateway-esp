#include <esp_now.h>
#include <WiFi.h>

// Structure to receive data (must match what your sensor nodes send)
typedef struct struct_message {
    char node_id[32];
    float dist;
    float temp;
    int rain;
    float vib;
} struct_message;

struct_message incomingReadings;

// Callback function executed when data is received via ESP-NOW
void OnDataRecv(const uint8_t * mac, const uint8_t *incomingData, int len) {
    memcpy(&incomingReadings, incomingData, sizeof(incomingReadings));
    
    // Print the received telemetry as a JSON string to the Serial port for Python server.py
    Serial.print("{\"node_id\":\"");
    Serial.print(incomingReadings.node_id);
    Serial.print("\",\"dist\":");
    Serial.print(incomingReadings.dist);
    Serial.print(",\"temp\":");
    Serial.print(incomingReadings.temp);
    Serial.print(",\"rain\":");
    Serial.print(incomingReadings.rain);
    Serial.print(",\"vib\":");
    Serial.print(incomingReadings.vib);
    Serial.println("}");
}

void setup() {
    Serial.begin(115200);
    
    // Set device as a Wi-Fi Station
    WiFi.mode(WIFI_STA);

    // Initialize ESP-NOW
    if (esp_now_init() != ESP_OK) {
        Serial.println("Error initializing ESP-NOW");
        return;
    }

    // Register the receive callback function
    esp_now_register_recv_cb(OnDataRecv);
}

void loop() {
    // Gateway simply listens in the background via callback
    delay(1000);
}
